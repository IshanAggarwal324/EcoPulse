# EcoPulse AI Service — copy to .env

# MongoDB (same cluster as backend; Mongoose collection: energyreadings)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/ecopulse
# Alternative name (also supported):
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/ecopulse

# Optional
PORT=8000
DEBUG=false

# Primary artifact path (legacy/saved layout)
MODEL_DIR=models/saved
MODEL_FILENAME=lstm_model.keras
SCALER_FILENAME=scaler.save
ALLOW_MODEL_FREE_DUMMY=true

# Registry fallback (recommended with this repository layout)
ECOPULSE_MODEL_REGISTRY_DIR=models/registry
ECOPULSE_MODEL_NAME=lstm_energy_forecast
# Optional: pin a specific version folder (e.g. 20260527_130417)
# ECOPULSE_MODEL_VERSION=

# Forecasting window settings
LOOK_BACK_DAYS=30
HISTORY_DAYS=60
