# Copy to deploy/oracle/.env and fill in. This file is read by docker compose itself.
# NEVER commit the real .env.

# The public hostname of your API. It must already point to the server's IP.
# Free option: a DuckDNS subdomain such as myecopulse.duckdns.org
API_DOMAIN=myecopulse.duckdns.org

# One shared key that lets the backend call the AI and GenAI services.
# Use the SAME value you have on Render today so nothing else needs changing,
# or generate a new one:  openssl rand -hex 32
INTERNAL_SERVICE_API_KEY=replace-with-the-value-from-render
