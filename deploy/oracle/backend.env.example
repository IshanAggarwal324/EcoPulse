# Copy to deploy/oracle/.env.backend and fill in with the SAME values your Render
# backend uses today (Render dashboard > backend service > Environment).
# NEVER commit the real file.
#
# Do NOT set these here; docker-compose.yml sets them for the server:
#   PORT, NODE_ENV, REDIS_URL, AI_SERVICE_URL, GENAI_SERVICE_URL, INTERNAL_SERVICE_API_KEY

# --- Database (production Atlas database) ---
MONGO_URI=

# --- Auth: use the same secrets as Render so existing logins keep working ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Your Vercel site (browser origin allowed to call this API) ---
CORS_ORIGIN=https://eco-pulse-front.vercel.app
FRONTEND_URL=https://eco-pulse-front.vercel.app
SOCKET_CORS_ORIGIN=https://eco-pulse-front.vercel.app

# --- Registration CAPTCHA (whichever provider you use on Render) ---
# CAPTCHA_PROVIDER=turnstile
# TURNSTILE_SECRET=
# HCAPTCHA_SECRET=
# RECAPTCHA_SECRET=

# --- Blockchain (Sepolia) ---
RPC_URL=
SYNC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BLOCKCHAIN_SYNC_CHUNK_SIZE=5000
PRIVATE_KEY=
CARBON_CREDIT_ADDRESS=
ENERGY_TRADING_ADDRESS=
ENERGY_ESCROW_ADDRESS=
DISPUTE_RESOLUTION_ADDRESS=
RETIREMENT_REGISTRY_ADDRESS=
CARBON_CREDIT_BRIDGE_ADDRESS=
BLOCKCHAIN_SYNC_FROM_BLOCK=
CHAIN_ID=11155111

# --- Email (copy whichever you use on Render) ---
REQUIRE_EMAIL_VERIFICATION=true
REPORT_FROM_EMAIL=
# BREVO_API_KEY=
# RESEND_API_KEY=

# --- Metrics (required in production for /metrics; any random string) ---
# METRICS_TOKEN=

# --- Anything else that is set on your Render backend (INGESTION_MODE,
# REGISTRATION_OPEN, SIMULATOR_EMBEDDED, ...) goes here too. ---
