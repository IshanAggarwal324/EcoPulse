# Copy to deploy/oracle/.env.genai. Use the same values as your Render GenAI service.
# NEVER commit the real file.
#
# Set by docker-compose.yml, do not set here:
#   PORT, NODE_ENV, WEB_CONCURRENCY, INTERNAL_SERVICE_API_KEY

GEMINI_API_KEY=

# Must be non-empty and not "*" in production (only the backend calls this service).
GENAI_CORS_ORIGINS=https://eco-pulse-front.vercel.app

# Optional. Leave unset to use the defaults (gemini-3.6-flash / gemini-embedding-001).
# GENAI_MODEL=
# EMBEDDING_MODEL=
