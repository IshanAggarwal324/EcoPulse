# Copy to deploy/oracle/.env.ai. Use the same values as your Render AI service.
# NEVER commit the real file.
#
# Set by docker-compose.yml, do not set here:
#   PORT, NODE_ENV, WEB_CONCURRENCY, INTERNAL_SERVICE_API_KEY

# Production Atlas connection string (the AI service reads energy readings from it).
MONGODB_URI=

# Browser origins allowed to call the AI service. It is only called by the backend,
# so this just has to be non-empty and not "*" in production.
AI_CORS_ORIGINS=https://eco-pulse-front.vercel.app
