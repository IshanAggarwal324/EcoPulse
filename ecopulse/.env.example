# EcoPulse Frontend (Vite) — copy to .env.local for local dev
# On Vercel: add these in Project Settings → Environment Variables

# Backend API base URL (include /api/v1)
VITE_API_URL=http://localhost:5000/api/v1

# Socket.io server URL (same host as backend, no path)
VITE_SOCKET_URL=http://localhost:5000

# Socket.io client reconnection (optional)
# VITE_SOCKET_RECONNECT_ATTEMPTS=20
# VITE_SOCKET_RECONNECT_DELAY_MS=1000
# VITE_SOCKET_RECONNECT_DELAY_MAX_MS=10000
# VITE_SOCKET_CONNECT_TIMEOUT_MS=20000

# Deployed contract addresses (testnet or mainnet)
VITE_CARBON_CREDIT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_ENERGY_TRADING_ADDRESS=0x0000000000000000000000000000000000000000

# Expected EVM chain ID (required in production)
VITE_CHAIN_ID=11155111
# Optional display name for wallet_addEthereumChain
# VITE_CHAIN_NAME=Sepolia

# RPC URL used when prompting MetaMask to add a network (required in production)
VITE_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Local dev example values (do not use in production)
# VITE_CHAIN_ID=31337
# VITE_RPC_URL=http://127.0.0.1:8545
