# EcoPulse Frontend (Vite) — copy to .env.local for local dev
# On Vercel: add these in Project Settings → Environment Variables

# Backend API base URL (include /api/v1)
VITE_API_URL=http://localhost:5000/api/v1

# Socket.io server URL (same host as backend, no path)
VITE_SOCKET_URL=http://localhost:5000

# Socket.io client reconnection (optional)
# VITE_SOCKET_RECONNECT_ATTEMPTS=20
# VITE_SOCKET_RECONNECT_DELAY_MS=1000
# VITE_SOCKET_RECONNECT_DELAY_MAX_MS=10000
# VITE_SOCKET_CONNECT_TIMEOUT_MS=20000

# Deployed contract addresses (testnet or mainnet)
VITE_CARBON_CREDIT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_ENERGY_TRADING_ADDRESS=0x0000000000000000000000000000000000000000
# Module 5.1 — Escrow / Dispute contracts (optional; enables "Buy via escrow")
VITE_ENERGY_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
VITE_DISPUTE_RESOLUTION_ADDRESS=0x0000000000000000000000000000000000000000

# Expected EVM chain ID (required in production)
VITE_CHAIN_ID=11155111
# Optional display name for wallet_addEthereumChain
# VITE_CHAIN_NAME=Sepolia

# RPC URL advertised to MetaMask when prompting it to add the network.
# SECURITY: every VITE_* value referenced by the app is inlined verbatim into
# the public JS bundle, so this must be a KEYLESS public endpoint. The app no
# longer reads VITE_RPC_URL at all (an Alchemy/Infura key there was readable by
# anyone who downloaded the bundle) — the keyed provider belongs to the backend
# only, in the server-side RPC_URL variable.
# Leave unset for known chains (1, 137, 11155111, 80002, 31337): a built-in
# public endpoint is used.
# VITE_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Registration CAPTCHA (required when backend captcha secret is set)
# Pick one provider and set matching site key. Recommended: Cloudflare Turnstile.
# VITE_CAPTCHA_PROVIDER=turnstile
# VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
# VITE_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key
# VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
# VITE_RECAPTCHA_VERSION=v2

# Local dev example values (do not use in production)
# VITE_CHAIN_ID=31337
# VITE_PUBLIC_RPC_URL=http://127.0.0.1:8545
