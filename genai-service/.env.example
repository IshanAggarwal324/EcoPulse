
GEMINI_API_KEY=your-gemini-api-key-here
GENAI_MODEL=gemini-3.6-flash
# "minimal" avoids spending the output-token budget on hidden reasoning.
# Set to empty for models that do not support thinking levels.
GENAI_THINKING_LEVEL=minimal
GENAI_MAX_TOKENS=800
GENAI_MAX_INPUT_CHARS=12000
GENAI_ENABLED=true
GENAI_PORT=8001
GENAI_HOST=127.0.0.1
GENAI_CORS_ORIGINS=http://localhost:5173
INTERNAL_SERVICE_API_KEY=replace-with-shared-internal-service-key
# Required for all non-health endpoints (same value as backend INTERNAL_SERVICE_API_KEY)

# Embedding / Doc RAG (uses same GEMINI_API_KEY)
EMBEDDING_MODEL=gemini-embedding-001
# Changing the model or dimensions invalidates EMBEDDING_CACHE_PATH; it is rebuilt automatically.
EMBEDDING_DIMENSIONS=768
# Only this directory (recursively) is indexed. Never point at repo root,
# user uploads, or any dir containing .env / secrets. Use an absolute path in prod.
DOCS_DIR=../docs/assistant
# Local embedding cache file. Lock down to 0600 in prod (see doc_rag_service.py).
EMBEDDING_CACHE_PATH=

# Optional
# /health makes one tiny real Gemini call at most once per TTL window.
GENAI_HEALTH_PROBE_ENABLED=true
GENAI_HEALTH_PROBE_TTL_SECONDS=60
GENAI_HEALTH_PROBE_TIMEOUT_SECONDS=4
DEBUG=false
LOG_LEVEL=INFO
