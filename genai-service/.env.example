
GEMINI_API_KEY=your-gemini-api-key-here
GENAI_MODEL=gemini-2.0-flash
GENAI_MAX_TOKENS=800
GENAI_MAX_INPUT_CHARS=12000
GENAI_ENABLED=true
GENAI_PORT=8001
GENAI_HOST=127.0.0.1
GENAI_CORS_ORIGINS=http://localhost:5173
INTERNAL_SERVICE_API_KEY=replace-with-shared-internal-service-key
# Required for all non-health endpoints (same value as backend INTERNAL_SERVICE_API_KEY)

# Embedding / Doc RAG (uses same GEMINI_API_KEY)
EMBEDDING_MODEL=text-embedding-004
# Only this directory (recursively) is indexed. Never point at repo root,
# user uploads, or any dir containing .env / secrets. Use an absolute path in prod.
DOCS_DIR=../docs/assistant
# Local embedding cache file. Lock down to 0600 in prod (see doc_rag_service.py).
EMBEDDING_CACHE_PATH=

# Optional
DEBUG=false
LOG_LEVEL=INFO
