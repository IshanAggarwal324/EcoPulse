{
  "name": "genai-service",
  "version": "1.0.0",
  "description": "EcoPulse GenAI Service — Python FastAPI (Gemini assistant, report narration)",
  "private": true,
  "main": "main.py",
  "scripts": {
    "start": "python -m uvicorn main:app --host 0.0.0.0 --port 8001",
    "start:prod": "python -m gunicorn -k uvicorn.workers.UvicornWorker main:app --bind 0.0.0.0:${PORT:-8001} --workers 2",
    "dev": "python -m uvicorn main:app --reload --host 0.0.0.0 --port 8001",
    "test": "python -m unittest discover -s tests -p test_*.py"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
