# EcoPulse Backend — copy to .env and fill in production values
# NEVER commit .env to git

# MongoDB (required in production)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/ecopulse

# JWT (use dedicated secrets in production; JWT_SECRET is legacy fallback for development only)
JWT_SECRET=replace-with-long-random-secret
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Socket.io — CORS origin(s) for WebSocket handshake (comma-separated for multiple)
# Falls back to FRONTEND_URL, then * in non-production
SOCKET_CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Debounce analytics broadcasts when many readings arrive (ms)
# Realtime snapshot debounce for reading bursts (ms); full summary on blockchain events
SOCKET_ANALYTICS_DEBOUNCE_MS=750

# Socket.io server heartbeat (ms)
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=20000

# Explicitly allow simulateReading socket events (admin socket only). Keep disabled in production.
# ALLOW_SOCKET_SIMULATION=true

# Run the grid simulator inside the backend process so admins can start/stop
# and edit profiles from /admin/simulator without a separate CLI process.
# SIMULATOR_EMBEDDED=true

# Energy simulator (npm run simulate / simulate:rest)
SIM_TRANSPORT=socket
SOCKET_URL=http://localhost:5000
SIM_API_URL=http://localhost:5000
SIM_INTERVAL_MS=5000
SIM_INTERVAL_JITTER_MS=1500
SIM_USE_DB_NODES=true
SIM_TICK_ALL_NODES=false
SIM_SOCKET_RECONNECT_ATTEMPTS=30
SIM_SOCKET_RECONNECT_DELAY_MS=1000

# AI microservice URL (LSTM forecasting)
AI_SERVICE_URL=http://localhost:8000

# Gen AI microservice URL (Gemini assistant, report narration)
GENAI_SERVICE_URL=http://localhost:8001
# Shared backend -> internal service auth key (must match AI/GenAI service config)
INTERNAL_SERVICE_API_KEY=replace-with-shared-internal-service-key

# Redis (required in production for distributed rate limiting + pricing cache)
# REDIS_URL=redis://localhost:6379
# REDIS_TLS_URL=rediss://user:pass@your-redis.example.com:6380
# Optional TLS CA bundle for managed Redis (recommended in production)
# REDIS_TLS_CA_CERT=/path/to/redis-ca.pem
# Dev-only: set REDIS_TLS_INSECURE=true to skip TLS verification (never in production)

# General authenticated API rate limit (requests per minute per user/IP)
# API_RATE_LIMIT_MAX=120

# Ingestion dead-letter throttling (H24 — avoids Mongo write storms under bad traffic)
# INGESTION_ERROR_PERSIST=true
# INGESTION_ERROR_PERSIST_MAX=120
# INGESTION_ERROR_DEDUP_MS=60000

# MQTT device/node resolution cache (H23)
# MQTT_DEVICE_CACHE_TTL_MS=60000
# MQTT_DEVICE_CACHE_MAX=5000

# Blockchain (optional — leave empty to skip chain sync)
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
PRIVATE_KEY=your-server-wallet-private-key-never-use-hardhat-default
CARBON_CREDIT_ADDRESS=0x...
ENERGY_TRADING_ADDRESS=0x...

# Email delivery (Resend or SMTP — pick one)
# RESEND_API_KEY=re_xxx
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
REPORT_FROM_EMAIL=reports@ecopulse.local

# Background blockchain sync interval (ms)
BLOCKCHAIN_SYNC_INTERVAL_MS=60000
# Max blocks per eth_getLogs request (Alchemy free tier: use 500 or lower)
BLOCKCHAIN_SYNC_CHUNK_SIZE=500
# Optional override for first sync start block (defaults to contract deployment block)
# BLOCKCHAIN_SYNC_FROM_BLOCK=10992934
# Re-scan this many recent blocks on each sync to catch missed events
BLOCKCHAIN_SYNC_LOOKBACK=3000

# Admin bootstrap — one-time ops only (never enable in production runtime)
# BOOTSTRAP_ADMIN_EMAIL=admin@ecopulse.local
# BOOTSTRAP_ADMIN_SECRET=min-16-char-random-secret-for-promote-admin-script

# Dev-only scripts (testBlockchain, promote-admin) — never set in production
# ALLOW_DEV_SCRIPTS=true

# Email verification — required by default in production
REQUIRE_EMAIL_VERIFICATION=true

# Registration CAPTCHA (required in production — pair with frontend VITE_* site keys)
# Pick one provider secret. Must match frontend site key provider.
# CAPTCHA_PROVIDER=turnstile
# TURNSTILE_SECRET=your-turnstile-secret-key
# HCAPTCHA_SECRET=your-hcaptcha-secret-key
# RECAPTCHA_SECRET=your-recaptcha-secret-key
# CAPTCHA_SECRET=legacy-recaptcha-secret-alias
# RECAPTCHA_MIN_SCORE=0.5

# System health probes (used by /admin/health and /analytics/status)
# Max blocks behind chain head before blockchain sync is considered degraded
HEALTH_SYNC_LAG_THRESHOLD=50
# Per-service probe timeout in ms (MongoDB ping, ai_service, genai-service)
HEALTH_PROBE_TIMEOUT_MS=5000

# Admin API rate limit (requests per minute per user/ip)
ADMIN_RATE_LIMIT_MAX=200
# Forecast API rate limit (requests per 15 minutes per user/ip)
FORECAST_RATE_LIMIT_MAX=30

# Enable the device auth middleware + provisioning API. Leave false when the
# deployment only uses public grid APIs (Module 1.5) or the simulator.
DEVICE_AUTH_ENABLED=false
# bcrypt cost for device API key hashing (higher = slower brute force, more CPU).
DEVICE_API_KEY_BCRYPT_ROUNDS=12
# Lock a device after this many consecutive failed auth attempts.
DEVICE_AUTH_MAX_FAILED_ATTEMPTS=10
# How long a device stays locked (ms). Default 15 minutes.
DEVICE_AUTH_LOCKOUT_MS=900000
# Per-device telemetry rate limits by tier (used by the device rate limiter).
DEVICE_TIER_STANDARD_WINDOW_MS=60000
DEVICE_TIER_STANDARD_MAX=60
DEVICE_TIER_HIGH_WINDOW_MS=60000
DEVICE_TIER_HIGH_MAX=300

# ── Telemetry Ingestion (Sub-module 1.2) ───────────────────────────────────
# HTTP push fallback (POST /api/v1/telemetry). Auth via deviceAuth middleware.
# Max request body size for a single telemetry envelope (bytes). Default 4 KB.
TELEMETRY_MAX_BYTES=4096
# Dedup TTL — how long a messageId is remembered to reject replays (seconds).
TELEMETRY_DEDUP_TTL_SECONDS=86400
# Reject telemetry whose timestamp is outside ±this window of server time (ms).
# Set ALLOW_CLOCK_SKEW=true to disable the check entirely (dev only).
INGESTION_CLOCK_SKEW_MS=300000
# ALLOW_CLOCK_SKEW=false
# Dead-letter (IngestionError) retention in days.
INGESTION_ERROR_TTL_DAYS=14

# MQTT ingestion (optional; requires `npm install mqtt`). Disabled by default.
# Broker MUST use mqtts:// in production (MQTT_ALLOW_PLAIN=true overrides in dev).
MQTT_INGESTION_ENABLED=false
# MQTT_BROKER_URL=mqtts://broker.example:8883
# MQTT_CLIENT_ID=ecopulse-ingest
# MQTT_USERNAME=
# MQTT_PASSWORD=
MQTT_TOPIC=ecopulse/nodes/+/telemetry
MQTT_PAYLOAD_MAX_BYTES=4096

# ── Time-Series Storage (Sub-module 1.3) ────────────────────────────────────
# Enable the MongoDB time-series collection + dual-write + rollups. OFF by
# default — legacy `energyreadings` stays the source of truth until cutover.
# Run `node scripts/migrate-readings-to-timeseries.js` to backfill history first.
TIMESERIES_ENABLED=false
# Dual-write (default true while enabled): new readings land in BOTH legacy and
# time-series collections. Set false ONLY after cutover (1.4) to stop legacy writes.
TIMESERIES_DUAL_WRITE=true
TIMESERIES_COLLECTION=energyreadings_ts
TIMESERIES_GRANULARITY=minutes
# Raw high-resolution readings expire after N days (DB-level TTL). Hourly rollups
# are retained longer so analytics/AI history survives the raw expiry.
TIMESERIES_RAW_TTL_DAYS=90
ROLLUP_HOURLY_COLLECTION=energyreadings_hourly
ROLLUP_HOURLY_TTL_DAYS=730
ROLLUP_INTERVAL_MS=3600000
# AI/forecast lookback window (days).
FORECAST_LOOKBACK_DAYS=60
# Route analytics aggregations to read replicas. Options: primary | primaryPreferred
# | secondary | secondaryPreferred | nearest
TIMESERIES_READ_PREFERENCE=secondaryPreferred
# Quiesce the app during a time-series migration (required by the migrate script).
APP_READ_ONLY_MODE=false
# Migration script knobs.
MIGRATE_BATCH_SIZE=1000
MIGRATE_LOOKBACK_DAYS=0

# ── Simulator Cutover & Coexistence (Sub-module 1.4) ─────────────────────────
# Which ingestion sources are active. Options: simulated | device | public_api | hybrid
# Development default: hybrid (simulator + public APIs allowed; IoT optional).
# Production  default: public_api (simulator OFF, public APIs ON; IoT optional).
# In production + public_api/device the simulator is LOCKED DOWN: its mutation
# endpoints return 403 and the embedded runner refuses to start, so demo/seed
# data can never mix with billing/trading decisions.
# INGESTION_MODE=hybrid
# Max number of readings accepted by a single POST /admin/ingestion/backfill.
# Hard-clamped to an absolute ceiling to bound request processing time.
INGESTION_BACKFILL_MAX_BATCH=5000

# ── Public Grid API Ingestion (Sub-module 1.5) ──────────────────────────────
# Master feature flag. OFF by default — pollers never start until this is true
# AND INGESTION_MODE allows public APIs (public_api | hybrid).
PUBLIC_GRID_INGESTION_ENABLED=false
# Default per-source poll interval (ms). Honors each source's own pollIntervalMs.
PUBLIC_GRID_POLL_INTERVAL_MS=900000
# Outbound HTTP request timeout (ms). A single dead provider can't stall the loop.
PUBLIC_GRID_FETCH_TIMEOUT_MS=10000
# Circuit breaker: trip a source open after N consecutive failures...
PUBLIC_GRID_CB_FAILURE_THRESHOLD=5
# ...and hold it open (skip polls) for this cooldown (ms) before a half-open probe.
PUBLIC_GRID_CB_COOLDOWN_MS=900000
# Dedup window for public-api readings (seconds).
PUBLIC_GRID_DEDUP_TTL_SECONDS=86400
# Jitter window between sources in one scan (ms) — be a good citizen to free APIs.
PUBLIC_GRID_JITTER_MS=30000
# Absolute MW ceiling for outlier rejection when a source has no maxCapacityMw.
PUBLIC_GRID_DEFAULT_MAX_CAPACITY_MW=2000000
# Owner for admin-seeded grid-zone nodes (system/admin userId). If unset, the
# seed script falls back to the first admin user.
# PUBLIC_GRID_SYSTEM_USER_ID=

# Provider API keys — stored in env ONLY, never in MongoDB or the client.
# Only the NAME of the env var is persisted on the PublicGridSource document.
EIA_API_KEY=
ENTSOE_API_TOKEN=
FINGRID_API_KEY=

# ── Pricing Engine (Sub-module 2.1) ─────────────────────────────────────────
# Master feature flag. The curve endpoint stays behind `protect` regardless;
# this lets ops disable it without a deploy.
PRICING_ENABLED=true
# Hard price bounds (credits per kWh). Every curve point is clamped to this
# range so a malformed forecast can never emit a negative/runaway price.
PRICING_FLOOR_CC=0.02
PRICING_CEILING_CC=2.0
# Fallback base price when no historical trade data exists yet (cold start).
PRICING_DEFAULT_BASE_CC=0.08
# How strongly surplus (gen - con) pushes price DOWN (0..1).
PRICING_SURPLUS_COEFFICIENT=0.3
# Market anchor blend weight for historical avgUnitPrice (0..1). 0.3 => 70/30.
PRICING_MARKET_ANCHOR_WEIGHT=0.3
# Weight given to live order-book sell depth as additional supply pressure.
PRICING_MARKET_PRESSURE_WEIGHT=0.2
# Confidence band tuning. Bands widen as forecast confidence drops.
PRICING_BAND_BASE=0.05
PRICING_BAND_UNCERTAINTY_SCALE=0.5
PRICING_MIN_DEMAND_KWH=1
# Redis curve cache TTL (seconds) — prevents forecast spam.
PRICING_CACHE_TTL_SECONDS=300
# Historical trade lookback for the market anchor (days).
PRICING_HISTORICAL_LOOKBACK_DAYS=30
# Pricing API rate limit (requests per 15 minutes per user/ip).
PRICING_RATE_LIMIT_MAX=30

# ── Surplus / Listing Recommendations (Sub-module 2.2) ──────────────────────
# Minimum forecast surplus (kWh over the horizon) to warrant a recommendation.
PRICING_MIN_SURPLUS_KWH=1
# Hard cap on recommended energyAmount (kWh) — bounds runaway forecasts.
PRICING_MAX_RECOMMENDATION_KWH=10000
# How long a recommendation stays valid (minutes). Stale ones are rejected.
PRICING_RECOMMENDATION_TTL_MINUTES=15
# Surplus scan horizon (hours) when none is requested.
PRICING_RECOMMENDATION_HORIZON_HOURS=168

# ── Auto-Bid/Ask Matcher (Sub-module 2.3) ───────────────────────────────────
# Master feature flag. FAIL-CLOSED: the matcher never starts, the worker refuses
# to tick, and policy enablement is rejected until this is true. v1 is notify-only.
AUTO_TRADING_ENABLED=false
# v2 path (relayed on-chain auto-submit). Off by default; requires a relayer.
# Leave false for v1 — the backend never holds private keys; the user always
# confirms each listing in MetaMask.
AUTO_TRADING_AUTO_SUBMIT=false
# Matcher cadence (ms). Default 15 min. Never tighter than 1/min.
AUTO_MATCHER_INTERVAL_MS=900000
# Per-policy defaults (a policy may clamp further, bounded by an absolute ceiling).
AUTO_TRADING_MAX_LISTINGS_PER_DAY=3
AUTO_TRADING_MAX_TOTAL_CC_PER_DAY=1000
AUTO_TRADING_MIN_TIME_BETWEEN_MS=3600000
AUTO_TRADING_MIN_SURPLUS_KWH=1
# How long a signed listing intent stays valid (ms). Guardrail: default 24h.
AUTO_TRADING_INTENT_TTL_MS=86400000
# Fixed-discount strategy default percent off the forecast-derived unit price.
AUTO_TRADING_FIXED_DISCOUNT_PERCENT=5
# Policy + enable API rate limits (per 15 min per user/ip).
AUTO_POLICY_RATE_LIMIT_MAX=60
AUTO_POLICY_ENABLE_RATE_LIMIT_MAX=20
# Notification retention (days) for the in-app Notification store.
NOTIFICATION_TTL_DAYS=30

# Chain id used for EIP-712 signature verification (should match the frontend's
# VITE_CHAIN_ID). Falls back to a local dev chain id for tests.
# CHAIN_ID=31337
